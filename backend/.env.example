STORAGE_BACKEND=sqlite
SQLITE_PATH=data/call_help.sqlite3
# Empty is local development only. Set before exposing the API on a network.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MIN_CONFIDENCE=0.7
ALERT_COOLDOWN_SECONDS=30

SUPABASE_URL=
SUPABASE_SECRET_KEY=

SMS_MODE=dry_run
ALERT_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_RECIPIENTS=

# Brevo transactional-email fallback. Set ALERT_PROVIDER=brevo_email to enable.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CALL_HELP
BREVO_RECIPIENTS=

GEMINI_API_KEY=
# Select an available generateContent model in your Google AI project.
GEMINI_MODEL=
