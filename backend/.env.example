STORAGE_BACKEND=sqlite
SQLITE_PATH=data/call_help.sqlite3
# Empty is local development only. Set before exposing the API on a network.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MIN_CONFIDENCE=0.7
ALERT_COOLDOWN_SECONDS=30

SUPABASE_URL=
SUPABASE_SECRET_KEY=

SMS_MODE=dry_run
# sms, or whatsapp for the Twilio WhatsApp sandbox (TWILIO_FROM_NUMBER = the sandbox number)
SMS_CHANNEL=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_RECIPIENTS=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
