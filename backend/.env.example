STORAGE_BACKEND=sqlite
SQLITE_PATH=data/call_help.sqlite3
# Required for authenticated API requests; use the same value in this machine's cv_engine/.env.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MIN_CONFIDENCE=0.7
# Automatic email alerts require confidence strictly above this value.
ALERT_MIN_CONFIDENCE=0.9
ALERT_COOLDOWN_SECONDS=30

SUPABASE_URL=
SUPABASE_SECRET_KEY=

ALERT_PROVIDER=none

# Optional Brevo transactional email. Set ALERT_PROVIDER=brevo_email to enable.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CALL_HELP
BREVO_RECIPIENTS=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
