<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hazardlens.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_ME/Hazard-Lens/tools/backup_data.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_ME/Hazard-Lens</string>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>StandardOutPath</key>
  <string>/tmp/hazard-lens-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hazard-lens-backup.err</string>
</dict>
</plist>
