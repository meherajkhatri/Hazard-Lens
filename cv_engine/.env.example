# Copy to cv_engine/.env (gitignored) and fill in. Never commit the real file.
API_KEY=
BACKEND_URL=http://localhost:8000
CAMERA_ID=zone-1-cam-1
ZONE_ID=Zone 1
# Phone camera app stream instead of a webcam, e.g. http://192.168.1.23:8080/video
CAMERA_URL=
DEVICE=cpu

# MJPEG stream consumed by the frontend camera panel.
STREAM_PORT=8001
