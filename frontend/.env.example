# Server-side only; must match backend/.env API_KEY.
BACKEND_URL=http://127.0.0.1:8000
API_KEY=
# Browser-reachable address of the CV laptop. Leave empty for no camera.
NEXT_PUBLIC_CAMERA_STREAM_URL=http://localhost:8001/stream
NEXT_PUBLIC_CAMERA_ZONE=Zone 1

# Browser webcam -> Flask/PyTorch detection service.
NEXT_PUBLIC_CV_API_URL=http://127.0.0.1:5000
NEXT_PUBLIC_CV_DETECTION_FPS=5
# browser = getUserMedia + Flask detection; stream preserves the existing MJPEG mode.
NEXT_PUBLIC_CAMERA_MODE=browser
