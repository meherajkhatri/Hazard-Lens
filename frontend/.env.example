# Server-side only; must match backend/.env API_KEY.
BACKEND_URL=http://127.0.0.1:8000
API_KEY=
# Browser-reachable address of the CV laptop. Leave empty for no camera.
NEXT_PUBLIC_CAMERA_STREAM_URL=http://localhost:8001/stream
NEXT_PUBLIC_CAMERA_ZONE=Zone 1
# One stream per camera ID. A newly detected fall automatically focuses that camera.
# NEXT_PUBLIC_CAMERA_STREAMS={"zone-1-cam-1":"http://192.168.1.20:8001/stream","zone-1-cam-2":"http://192.168.1.21:8001/stream"}
# Legacy single stream identity; must match CAMERA_ID in the CV engine.
NEXT_PUBLIC_CAMERA_ID=zone-1-cam-1
# Zones for entries in NEXT_PUBLIC_CAMERA_STREAMS (default is NEXT_PUBLIC_CAMERA_ZONE).
# NEXT_PUBLIC_CAMERA_ZONES={"zone-1-cam-1":"Zone 1","zone-1-cam-2":"Zone 1"}
# These are the CV engine's annotated outputs, NEVER raw password/API-key camera URLs.
