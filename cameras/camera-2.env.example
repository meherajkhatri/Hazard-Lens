# Copy to camera-2.env (ignored). Fill secrets locally, never in NEXT_PUBLIC_*.
CAMERA_ID=zone-1-cam-2
ZONE_ID=Zone 1
# Pick ONE source for this camera:
#  - USB camera: leave CAMERA_URL empty and set CAMERA_INDEX. Find the index with
#    python -m cv_engine.run --list-cameras  (0 is usually the laptop's built-in webcam).
#  - IP/phone camera: set CAMERA_URL, e.g. http://CAMERA_2_IP/video (CAMERA_INDEX is then ignored).
CAMERA_INDEX=2
CAMERA_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=
# basic or digest; leave username/password empty for header-only API auth.
CAMERA_AUTH=basic
CAMERA_HTTP_HEADERS={}
BACKEND_URL=http://127.0.0.1:8000
API_KEY=
STREAM_PORT=8002
# LAN address of the computer running THIS CV engine.
PUBLIC_HOST=CV_LAPTOP_LAN_IP
DEVICE=cpu
