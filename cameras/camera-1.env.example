# Copy to camera-1.env (ignored). Fill secrets locally, never in NEXT_PUBLIC_*.
CAMERA_ID=zone-1-cam-1
ZONE_ID=Zone 1
CAMERA_URL=http://CAMERA_1_IP/video
CAMERA_USERNAME=
CAMERA_PASSWORD=
# basic or digest; leave username/password empty for header-only API auth.
CAMERA_AUTH=basic
CAMERA_HTTP_HEADERS={}
BACKEND_URL=http://127.0.0.1:8000
API_KEY=
STREAM_PORT=8001
# LAN address of the computer running THIS CV engine.
PUBLIC_HOST=CV_LAPTOP_LAN_IP
DEVICE=cpu
