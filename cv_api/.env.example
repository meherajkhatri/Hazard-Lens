CV_API_HOST=0.0.0.0
CV_API_PORT=5000
CV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MODEL_PATH=yolov8n-pose.pt
DEVICE=auto
FALL_CONFIDENCE_THRESHOLD=0.68
FALL_CONFIRMATION_SECONDS=0.60
MIN_KEYPOINT_CONF=0.25
FALL_DROP_VELOCITY=0.28
DOWN_TORSO_MIN_DEG=45
DOWN_ASPECT_MIN=0.75
COLLAPSE_HEIGHT_RATIO=0.68

# Near-miss detection uses a lightweight second YOLO model for nearby vehicles.
NEAR_MISS_ENABLED=true
VEHICLE_MODEL_PATH=yolov8n.pt
VEHICLE_CONFIDENCE_THRESHOLD=0.30
NEAR_MISS_DISTANCE_RATIO=0.18
NEAR_MISS_CONFIRMATION_FRAMES=2
NEAR_MISS_EVERY_N_FRAMES=2

# Safe by default. false = detect/show/log only; no backend alert is sent.
EMERGENCY_MODE=false
TEST_MODE=true
CAMERA_ID=browser-cam-1
ZONE_ID=Zone 1
EVENT_LOG=backend/data/cv_api_falls.jsonl

# Used only when EMERGENCY_MODE=true.
BACKEND_URL=http://127.0.0.1:8000
API_KEY=
